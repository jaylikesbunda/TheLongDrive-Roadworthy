{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Long Drive: Roadworthy",
  "version": "0.2.0-pre2",
  "identifier": "io.github.roadworthy.installer",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "The Long Drive: Roadworthy",
        "width": 600,
        "height": 500,
        "minWidth": 540,
        "minHeight": 460,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
